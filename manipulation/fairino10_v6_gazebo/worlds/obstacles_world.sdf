<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="obstacles_world">

    <!--
      Physics engine settings.
      max_step_size: how much simulated time passes per physics step.
      real_time_factor: 1.0 = simulation runs at real time speed.
    -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>

    <!--
      Core Gazebo Harmonic system plugins.
      Physics: runs the physics engine each step.
      UserCommands: allows spawning/deleting models at runtime.
      SceneBroadcaster: publishes scene state so GzClient can render it.
    -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <!--
      Sunlight: directional light simulating the sun.
      Without this the scene renders completely black.
    -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!--
      Ground plane: flat surface the robot sits on.
      static=true means infinite mass, won't move under forces.
    -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- C1: Right foreground obstacle culm -->
    <model name="culm_1">
      <static>true</static>
      <pose>1.0 0.25 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>3.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>3.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.6 0.2 1</ambient>
            <diffuse>0.3 0.6 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- C2: Left foreground obstacle culm -->
    <model name="culm_2">
      <static>true</static>
      <pose>1.0 -0.25 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>3.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>3.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.6 0.2 1</ambient>
            <diffuse>0.3 0.6 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- C3: Target culm — visual only, no collision -->
    <model name="culm_3_target">
      <static>true</static>
      <pose>1.3 0.0 1.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>3.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.9 0.1 1</ambient>
            <diffuse>0.8 0.9 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Harvest point marker: red sphere at cut height on C3 -->
    <model name="harvest_point">
      <static>true</static>
      <pose>1.3 0.0 0.35 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.03</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>